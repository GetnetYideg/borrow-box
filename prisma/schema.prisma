// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//ENUMS
enum Status{
    AVAILABLE
    UNAVAILABLE
}

enum Category{
    ELECTRONICS
    CLOTHING
    BOOKS
    SCHOOL
    SPORTS
    TOOLS
    HOUSEHOLD
    OTHER
}

enum LendingStatus{
    ACTIVE
    DUESOON
    OVERDUE
    RETURNED
}

//MODELS

model User{
    id           String   @id @default(uuid()) @db.Uuid
    name         String
    email        String @unique
    passwordHash String
    item         Item[]
    borrower     Borrower[]
    createdAt    DateTime @default(now())
    updatedAt    DateTime @default(now())
}

model Item{
    id          String @id @default(uuid()) @db.Uuid
    userId      String @db.Uuid
    name        String
    description String?
    category    Category @default(OTHER) 
    imageUrl    String?
    identifier  String?
    status      Status
    lendingRecord LendingRecord[]
    createdAt   DateTime @default(now())
    updatedAt   DateTime @default(now())

    owner       User @relation(fields: [userId], references: [id])
}

model Borrower{
    id          String @id @default(uuid()) @db.Uuid
    userId      String @db.Uuid
    name        String
    phone       String @unique
    email       String @unique
    notes       String?
    lendingRecord LendingRecord[]
    createdAt   DateTime @default(now())
    updatedAt   DateTime @default(now())

    lender      User @relation(fields: [userId], references: [id])
}

model LendingRecord{
    id                  String @id @default(uuid()) @db.Uuid
    itemId              String @db.Uuid
    borrowerId          String @db.Uuid
    lentAt              DateTime @default(now())
    expectedReturnDate  DateTime
    returnedAt          DateTime?
    notes               String?
    status              LendingStatus @default(ACTIVE)
    createdAt           DateTime @default(now())
    updatedAt           DateTime @default(now())

    borrower            Borrower @relation(fields: [borrowerId], references: [id])
    item                Item @relation(fields: [itemId], references: [id])
}